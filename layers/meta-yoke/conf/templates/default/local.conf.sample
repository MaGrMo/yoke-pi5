# Згенеровано з layers/meta-yoke/conf/templates/default/local.conf.sample
# Змінюйте шаблон, а не build/conf/local.conf

MACHINE ??= "raspberrypi5"
DISTRO ?= "poky"

# DL_DIR і SSTATE_DIR задаються з build.sh через змінні середовища
DL_DIR ?= "${TOPDIR}/../cache/downloads"
SSTATE_DIR ?= "${TOPDIR}/../cache/sstate-cache"

# Raspberry Pi
ENABLE_UART = "1"
LICENSE_FLAGS_ACCEPTED = "synaptics-killswitch"
IMAGE_FSTYPES = "wic.bz2 wic.bmap"

# meta-virtualization
DISTRO_FEATURES:append = " virtualization"

# debug-tweaks (root без пароля) не вмикаємо: вхід через користувача з рецепту yoke-user
EXTRA_IMAGE_FEATURES ?= ""

INHERIT += "rm_work"
USER_CLASSES ?= "buildstats"
PATCHRESOLVE = "noop"

BB_DISKMON_DIRS ??= "\
    STOPTASKS,${TMPDIR},1G,100K \
    STOPTASKS,${DL_DIR},1G,100K \
    STOPTASKS,${SSTATE_DIR},1G,100K \
    STOPTASKS,/tmp,100M,100K \
    HALT,${TMPDIR},100M,1K \
    HALT,${DL_DIR},100M,1K \
    HALT,${SSTATE_DIR},100M,1K \
    HALT,/tmp,10M,1K"

CONF_VERSION = "2"
